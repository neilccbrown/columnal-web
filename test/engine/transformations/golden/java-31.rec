QFN @END DISPLAY
@END QFN TRANSFORMATION

TRANSFORMATION @BEGIN BIF
BIF "Trans 3"
BIF calculate
BIF SOURCE "Trans 1"
BIF @BEGIN
BIF CALCULATE "New 3" @EXPRESSION column\\result = @call function\\list\element(table\\Trans 1#result, 1)
BIF CALCULATE "New 2" @EXPRESSION @call function\\boolean\not(column\\result)
BIF CALCULATE result @EXPRESSION @call function\\list\list length(table\\Trans 1#result)
BIF @END
BIF DISPLAY @BEGIN
BIF POSITION 1 1
BIF SHOWCOLUMNS ALL
BIF @END DISPLAY
@END BIF TRANSFORMATION

