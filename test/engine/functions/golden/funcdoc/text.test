 @call function\\join text with(["a", "b", "c"], "+") = ("a+b+c")
 @call function\\join text with(["Blanks", "", "Count"], ";") = ("Blanks;;Count")
 @call function\\join text with(["Hello", " ", "Moon"], "-") = ("Hello- -Moon")
 @call function\\join text with(["Hi"], ",") = ("Hi")
 @call function\\join text with([], ",") = ("")

