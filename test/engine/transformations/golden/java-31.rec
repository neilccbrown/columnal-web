TRANSFORMATION @BEGIN CWY
CWY "Trans 1"
CWY check
CWY SOURCE "Test 0"
CWY @BEGIN
CWY CHECK NOROWS @EXPRESSION column\\GenCol 198 > @call function\\list\element(table\\Test 0#GenCol 198, 2)
CWY @END
CWY DISPLAY @BEGIN
CWY POSITION 1 1
CWY SHOWCOLUMNS ALL
CWY @END DISPLAY
@END CWY TRANSFORMATION

TRANSFORMATION @BEGIN AAH
AAH "Trans 4"
AAH correct
AAH SOURCE "Trans 1"
AAH @BEGIN
AAH EDIT "result" @TYPE Boolean
AAH EDITCOLUMN "result" @TYPE Boolean
AAH REPLACEMENT @VALUE  false @ENDVALUE  @VALUE  false  @ENDVALUE
AAH @END
AAH DISPLAY @BEGIN
AAH POSITION 1 1
AAH SHOWCOLUMNS ALL
AAH @END DISPLAY
@END AAH TRANSFORMATION

