 @call function\\replace many([(find: "at", replace: "og"), (find: "the", replace: "a")], "the cat in the hat") = ("a cog in a hog")
 @call function\\replace many([(find: "ooo", replace: "eow"), (find: "oo", replace: "eh")], "Mooo moo mooo!") = ("Meow meh meow!")
 @call function\\replace many([(find: "apple", replace: "pear")], "orange") = ("orange")
 @call function\\replace many([], "original") = ("original")
 @call function\\join text(["a", "b", "c"]) = ("abc")
 @call function\\join text(["Hello", " ", "Moon"]) = ("Hello Moon")
 @call function\\join text([]) = ("")

