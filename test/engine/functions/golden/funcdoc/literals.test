dateym{April 2003} = (@call function\\dateym from ym(2003{year}, 4{month}))
dateym{11/2010} = (@call function\\dateym from ym(2010{year}, 11{month}))
dateym{Sep 1921} = (@call function\\dateym from ym(1921{year}, 9{month}))
date{10 April 2003} = (@call function\\date from ymd(2003{year}, 4{month}, 10{day}))
date{2010-11-28} = (@call function\\date from ymd(2010{year}, 11{month}, 28{day}))
date{Sep 3 1921} = (@call function\\date from ymd(1921{year}, 9{month}, 3{day}))
time{08:57} = (@call function\\time from hms(8{hour}, 57{minute}, 0{s}))
time{9:12:03 PM} = (@call function\\time from hms(21{hour}, 12{minute}, 3{s}))
time{23:59:59.999999} = (@call function\\time from hms(23{hour}, 59{minute}, 59.999999{s}))
datetime{10 April 2003 08:57} = (@call function\\datetime from dt(@call function\\date from ymd(2003{year}, 4{month}, 10{day}), @call function\\time from hms(8{hour}, 57{minute}, 0{s})))
datetime{2010-11-28 9:12:03 PM} = (@call function\\datetime from dt(@call function\\date from ymd(2010{year}, 11{month}, 28{day}), @call function\\time from hms(21{hour}, 12{minute}, 3{s})))
datetime{Sep 3 1921 23:59:59.999999} = (@call function\\datetime from dt(@call function\\date from ymd(1921{year}, 9{month}, 3{day}), @call function\\time from hms(23{hour}, 59{minute}, 59.999999{s})))
datetimezoned{10 April 2003 08:57+00:00} = (@call function\\datetimezoned from dtz(@call function\\date from ymd(2003{year}, 4{month}, 10{day}), @call function\\time from hms(8{hour}, 57{minute}, 0{s}), "+00:00"))
datetimezoned{2010-11-28 9:12:03 PM Asia/Jakarta} = (@call function\\datetimezoned from dtz(@call function\\date from ymd(2010{year}, 11{month}, 28{day}), @call function\\time from hms(21{hour}, 12{minute}, 3{s}), "Asia/Jakarta"))
datetimezoned{Sep 3 1921 23:59:59.999999 Africa/Khartoum} = (@call function\\datetimezoned from dtz(@call function\\date from ymd(1921{year}, 9{month}, 3{day}), @call function\\time from hms(23{hour}, 59{minute}, 59.999999{s}), "Africa/Khartoum"))
(@call function\\from text to(type{Boolean}, "true")) = (true)
(@call function\\from text to(type{Number{minute}}, "93")) = (93{minute})
(@call function\\from text to(type{@apply Optional(Date)}, "None")) = (tag\\Optional\None)
