{
  // GUI tests in Vitest browser mode (test/gui), which run in the browser and import the app's Vue
  // components, so are checked with the app.  They also use the engine tests' generators and fixtures,
  // and the property-test support.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.browser-tests.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["test/gui/**/*.ts", "src/**/*.ts", "src/**/*.vue", "test/engine/**/fixtures/**/*.ts", "test/gui-logic/**/fixtures/**/*.ts", "test/support/**/*.ts"],
  "exclude": ["test/support/**/*.test.ts"]
}
