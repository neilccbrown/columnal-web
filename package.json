{
  "name": "columnal-web",
  "version": "0.1.0",
  "description": "Columnal, safer and smoother data table processing, as a client-side web app (TypeScript port of the JavaFX original).",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "npm run gen",
    "gen": "node scripts/gen-parsers.mjs && node scripts/gen-funcdoc.mjs",
    "gen:parsers": "node scripts/gen-parsers.mjs",
    "gen:funcdoc": "node scripts/gen-funcdoc.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run gen",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "depcheck": "depcruise src test --config .dependency-cruiser.cjs",
    "pretest": "npm run gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gui": "playwright test",
    "fetch-reference": "scripts/fetch-reference.sh",
    "port-status": "tsx scripts/port-status.ts"
  },
  "dependencies": {
    "@js-joda/core": "^6.3.0",
    "@js-joda/locale": "^5.3.2",
    "@js-joda/locale_en": "^5.3.2",
    "@js-joda/timezone": "^3.1.0",
    "antlr4ng": "^3.0.16",
    "decimal.js": "^10.6.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@xmldom/xmldom": "0.9.12",
    "antlr-ng": "^1.0.10",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "iconv-lite": "0.7.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
