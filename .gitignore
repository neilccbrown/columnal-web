# Dependencies and build output
/node_modules
/dist
/out-tsc
/tmp
*.tsbuildinfo

# Generated by scripts/gen-parsers.mjs and scripts/gen-funcdoc.mjs (run on install, test, typecheck,
# dev and build)
/src/engine/parsers/generated/
/src/engine/functions/generated/

# The pinned Java original, fetched by scripts/fetch-reference.sh
/reference/

# Test output
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors
.vscode/*
.DS_Store

# Vitest browser mode (failure screenshots, traces)
.vitest/
__traces__/
