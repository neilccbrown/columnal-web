TRANSFORMATION @BEGIN NHH
NHH "Trans 4"
NHH sort
NHH SOURCE "Test 0"
NHH @BEGIN
NHH DESCENDING Missing
NHH ASCENDING "GenCol 10"
NHH @END
NHH DISPLAY @BEGIN
NHH POSITION 1 1
NHH SHOWCOLUMNS ALL
NHH @END DISPLAY
@END NHH TRANSFORMATION

TRANSFORMATION @BEGIN DZD
DZD "Trans 5"
DZD check
DZD SOURCE "Test 0"
DZD @BEGIN
DZD CHECK NOROWS @EXPRESSION column\\GenCol 9 >= @call function\\list\element(table\\Test 0#GenCol 9, 2)
DZD @END
DZD DISPLAY @BEGIN
DZD POSITION 1 1
DZD SHOWCOLUMNS ALL
DZD @END DISPLAY
@END DZD TRANSFORMATION

TRANSFORMATION @BEGIN ADN
ADN "Trans 2"
ADN "drop.columns"
ADN SOURCE "Test 0"
ADN @BEGIN
ADN HIDE "GenCol 7"
ADN HIDE "GenCol 8"
ADN @END
ADN DISPLAY @BEGIN
ADN POSITION 1 1
ADN SHOWCOLUMNS ALL
ADN @END DISPLAY
@END ADN TRANSFORMATION

TRANSFORMATION @BEGIN RHY
RHY "Trans 6"
RHY concatenate
RHY SOURCE "Trans 2" "Trans 5" "Trans 4"
RHY @BEGIN
RHY @INCOMPLETE OMIT SOURCE 
RHY @END
RHY DISPLAY @BEGIN
RHY POSITION 1 1
RHY SHOWCOLUMNS ALL
RHY @END DISPLAY
@END RHY TRANSFORMATION

TRANSFORMATION @BEGIN ULJ
ULJ "Trans 3"
ULJ "drop.columns"
ULJ SOURCE "Trans 2"
ULJ @BEGIN
ULJ HIDE "GenCol 9"
ULJ HIDE Missing
ULJ @END
ULJ DISPLAY @BEGIN
ULJ POSITION 1 1
ULJ SHOWCOLUMNS ALL
ULJ @END DISPLAY
@END ULJ TRANSFORMATION

TRANSFORMATION @BEGIN MUW
MUW "Trans 1"
MUW filter
MUW SOURCE "Test 0"
MUW @BEGIN
MUW KEEPIF column\\GenCol 10 < @call function\\list\element(table\\Test 0#GenCol 10, 2)
MUW @END
MUW DISPLAY @BEGIN
MUW POSITION 1 1
MUW SHOWCOLUMNS ALL
MUW @END DISPLAY
@END MUW TRANSFORMATION

