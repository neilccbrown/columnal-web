 @call function\\as type(type{Boolean}, @call function\\from text("True")) = (true)
 @call function\\as type(type{[Date]}, []) = ([])
(@call function\\as type(@call function\\type of([3]), @call function\\from text("[1, 2, 5]"))) = ([1, 2, 5])
 @call function\\type of([(a:true, b:6)]) = (type{[(a:Boolean, b:Number)]})
 @call function\\type of((t: time{00:00}, s: 21{s})) = (type{(t: Time, s: Number{s})})
 @call function\\convert unit(unit{cm}, 1{inch}) = (2.54{cm})
 @call function\\convert unit(unit{l}, 30{cm} * 20{cm} * 10{cm}) = (6{l})
 @call function\\convert unit(unit{mile/hour}, (100{m} / 9.58{s})) =~ (23.350{mile/hour} ± 0.001{mile/hour})
!!!  @call function\\convert unit(unit{m^2}, 10{m})
