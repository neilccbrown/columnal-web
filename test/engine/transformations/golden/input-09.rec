COLUMNAL
VERSION 3

UNITS @BEGIN UU
UU @UNIT myUnit "Custom unit for testing"
UU @UNIT hogshead "An English wine cask hogshead" = 2387/10 * l
UU @ALIAS myAlias = myUnit
@END UU UNITS

TYPES @BEGIN TT
TT @TYPE A @tagged ( Single )
TT @TYPE B @tagged ( Single )
TT @TYPE C @tagged ( Blank | Num ( Number ) )
TT @TYPE EitherMyOrHogshead @tagged ( Left ( Number { myUnit } ) | Right ( Number { hogshead } ) )
TT @TYPE EitherNumUnit @tagged @unitvar a @unitvar b ( Left ( Number { @unitvar a } ) | Right ( Number { @unitvar b } ) )
TT @TYPE Nested @tagged ( A ( A ) | C ( C ) )
@END TT TYPES
DATA @BEGIN IEX
IEX "Test 0"
IEX FORMAT @BEGIN
IEX @COLUMN GenCol 33 @TYPE @apply   Optional ( @apply   Optional ( Text ) ) @DEFAULT None
IEX @COLUMN GenCol 34 @TYPE Number {m^3/s^3} @DEFAULT 1
IEX @COLUMN GenCol 35 @TYPE Number {m^2} @DEFAULT 32917553
IEX @COLUMN GenCol 36 @TYPE @apply   EitherNumUnit {1} {m} @DEFAULT Left ( 0 )
IEX @COLUMN GenCol 37 @TYPE EitherMyOrHogshead @DEFAULT Left ( 2147483647 )
IEX @COLUMN GenCol 38 @TYPE Number {m^3/s^3} @DEFAULT 1762437616629
IEX @END FORMAT
IEX VALUES @BEGIN
IEX   None , -32768 , 45 , Right ( -128 ) , Right ( 0.383592 ) , 32767
IEX   None , 0.349187 , 532495200 , Left ( 0.950724 ) , Right ( 0.060729 ) , @INVALID "#1774749523"
IEX @END VALUES
IEX DISPLAY @BEGIN
IEX POSITION 1 1
IEX SHOWCOLUMNS ALL
IEX @END DISPLAY
@END IEX DATA

TRANSFORMATION @BEGIN WFL
WFL "Trans 1"
WFL correct
WFL SOURCE "Test 0"
WFL @BEGIN
WFL EDIT "GenCol 33" @TYPE @apply   Optional ( @apply   Optional ( Text ) )
WFL EDITCOLUMN "GenCol 37" @TYPE EitherMyOrHogshead
WFL REPLACEMENT @VALUE  None @ENDVALUE  @VALUE  Right ( 0.060729 )  @ENDVALUE
WFL @END
WFL DISPLAY @BEGIN
WFL POSITION 1 1
WFL SHOWCOLUMNS ALL
WFL @END DISPLAY
@END WFL TRANSFORMATION

TRANSFORMATION @BEGIN HON
HON "Trans 2"
HON concatenate
HON SOURCE "Trans 1"
HON @BEGIN
HON @INCOMPLETE DEFAULT SOURCE 
HON @END
HON DISPLAY @BEGIN
HON POSITION 1 1
HON SHOWCOLUMNS ALL
HON @END DISPLAY
@END HON TRANSFORMATION

TRANSFORMATION @BEGIN QCB
QCB "Trans 6"
QCB "drop.columns"
QCB SOURCE "Trans 2"
QCB @BEGIN
QCB HIDE Source
QCB HIDE "GenCol 36"
QCB HIDE "GenCol 37"
QCB @END
QCB DISPLAY @BEGIN
QCB POSITION 1 1
QCB SHOWCOLUMNS ALL
QCB @END DISPLAY
@END QCB TRANSFORMATION

TRANSFORMATION @BEGIN OGG
OGG "Trans 7"
OGG check
OGG SOURCE "Trans 1"
OGG @BEGIN
OGG CHECK STANDALONE @EXPRESSION false
OGG @END
OGG DISPLAY @BEGIN
OGG POSITION 1 1
OGG SHOWCOLUMNS ALL
OGG @END DISPLAY
@END OGG TRANSFORMATION

TRANSFORMATION @BEGIN OVZ
OVZ "Trans 4"
OVZ check
OVZ SOURCE "Trans 2"
OVZ @BEGIN
OVZ CHECK ALLROWS @EXPRESSION column\\GenCol 34 >= @call function\\list\element(table\\Trans 2#GenCol 34, 4)
OVZ @END
OVZ DISPLAY @BEGIN
OVZ POSITION 1 1
OVZ SHOWCOLUMNS ALL
OVZ @END DISPLAY
@END OVZ TRANSFORMATION

TRANSFORMATION @BEGIN GXP
GXP "Trans 5"
GXP check
GXP SOURCE "Trans 2"
GXP @BEGIN
GXP CHECK ANYROWS @EXPRESSION column\\GenCol 34 <= @call function\\list\element(table\\Trans 2#GenCol 34, 2)
GXP @END
GXP DISPLAY @BEGIN
GXP POSITION 1 1
GXP SHOWCOLUMNS ALL
GXP @END DISPLAY
@END GXP TRANSFORMATION

TRANSFORMATION @BEGIN BVT
BVT "Trans 3"
BVT aggregate
BVT SOURCE "Test 0"
BVT @BEGIN
BVT @END
BVT DISPLAY @BEGIN
BVT POSITION 1 1
BVT SHOWCOLUMNS ALL
BVT @END DISPLAY
@END BVT TRANSFORMATION

