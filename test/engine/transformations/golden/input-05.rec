TRANSFORMATION @BEGIN NCD
NCD "Trans 4"
NCD correct
NCD SOURCE "Trans 2"
NCD @BEGIN
NCD EDIT "result" @TYPE Boolean
NCD EDITCOLUMN "result" @TYPE Boolean
NCD REPLACEMENT @VALUE  false @ENDVALUE  @INVALIDVALUE  "#bad 1"  @ENDVALUE
NCD @END
