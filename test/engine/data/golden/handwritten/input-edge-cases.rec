COLUMNAL
VERSION 3

UNITS @BEGIN UU
UU @UNIT widget "A test unit"
@END UU UNITS

TYPES @BEGIN TT
TT @TYPE Opt @tagged @typevar t ( None | Some ( @typevar t ) )
@END TT TYPES
DATA @BEGIN ABC
ABC "Edge cases"
ABC FORMAT @BEGIN
ABC @COLUMN Num @TYPE Number {widget} @DEFAULT 0
ABC @COLUMN Txt @TYPE Text @DEFAULT ""
ABC @COLUMN Day @TYPE Date @DEFAULT 2000-01-01
ABC @COLUMN Maybe @TYPE @apply Opt(Number) @DEFAULT None
ABC @COLUMN Bool @TYPE Boolean @DEFAULT false
ABC @END FORMAT
ABC VALUES @BEGIN
ABC 1.50, "", 2000-01-02, Some(+5), true
ABC   -0  ,"a^qb^cc", 1999-12-31,None,false
ABC 007, "	tab and é😀", 0001-01-01, Some ( -0.000100 ), true
ABC 1., @INVALID "bad ^q value", @INVALID "x", @INVALID "y", @INVALID "z"
ABC 123456789012345678901234567890123456789, "x", 2000-02-29, Some(1.0), false
ABC @END VALUES
ABC DISPLAY @BEGIN
ABC POSITION 5 6
ABC SHOWCOLUMNS EXCEPT Num
ABC @END DISPLAY
@END ABC DATA
COMMENT @BEGIN CMT
CMT CONTENT @BEGIN
CMT   Leading spaces, ^q quotes ^q, and a caret ^c
CMT @END CONTENT
CMT DISPLAY @BEGIN
CMT POSITION 1 2 3 4
CMT @END DISPLAY
@END CMT COMMENT
DISPLAY @BEGIN DD
DD COLUMNWIDTH 0 25.5
@END DD DISPLAY
