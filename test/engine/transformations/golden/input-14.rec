COLUMNAL
VERSION 3

UNITS @BEGIN UU
UU @UNIT myUnit "Custom unit for testing"
UU @UNIT hogshead "An English wine cask hogshead" = 2387/10 * l
UU @ALIAS myAlias = myUnit
@END UU UNITS

TYPES @BEGIN TT
TT @TYPE A @tagged ( Single )
TT @TYPE B @tagged ( Single )
TT @TYPE C @tagged ( Blank | Num ( Number ) )
TT @TYPE EitherMyOrHogshead @tagged ( Left ( Number { myUnit } ) | Right ( Number { hogshead } ) )
TT @TYPE EitherNumUnit @tagged @unitvar a @unitvar b ( Left ( Number { @unitvar a } ) | Right ( Number { @unitvar b } ) )
TT @TYPE Nested @tagged ( A ( A ) | C ( C ) )
@END TT TYPES
DATA @BEGIN FBT
FBT "Test 0"
FBT FORMAT @BEGIN
FBT @COLUMN GenCol 62 @TYPE Number {m} @DEFAULT 4080225783
FBT @COLUMN GenCol 63 @TYPE A @DEFAULT Single
FBT @COLUMN GenCol 64 @TYPE Time @DEFAULT 07:54:38
FBT @COLUMN GenCol 65 @TYPE Date @DEFAULT 0617-02-16
FBT @END FORMAT
FBT VALUES @BEGIN
FBT   32767 , Single , 20:21:26.685138188 , 2006-12-04
FBT   0 , Single , 11:04:00 , 1341-05-19
FBT   1 , Single , 08:40:00 , 1940-03-31
FBT   229 , Single , 17:11:28.747031245 , 2009-05-27
FBT   0.103872 , Single , 19:13:00 , 1978-05-08
FBT   -2147483648 , Single , 17:05:54.993132102 , 1924-02-13
FBT @END VALUES
FBT DISPLAY @BEGIN
FBT POSITION 1 1
FBT SHOWCOLUMNS ALL
FBT @END DISPLAY
@END FBT DATA

TRANSFORMATION @BEGIN HPX
HPX "Trans 5"
HPX check
HPX SOURCE "Test 0"
HPX @BEGIN
HPX CHECK ANYROWS @EXPRESSION false
HPX @END
HPX DISPLAY @BEGIN
HPX POSITION 1 1
HPX SHOWCOLUMNS ALL
HPX @END DISPLAY
@END HPX TRANSFORMATION

TRANSFORMATION @BEGIN MQV
MQV "Trans 6"
MQV check
MQV SOURCE "Trans 5"
MQV @BEGIN
MQV CHECK NOROWS @EXPRESSION column\\result > @call function\\list\element(table\\Trans 5#result, 5)
MQV @END
MQV DISPLAY @BEGIN
MQV POSITION 1 1
MQV SHOWCOLUMNS ALL
MQV @END DISPLAY
@END MQV TRANSFORMATION

TRANSFORMATION @BEGIN IOA
IOA "Trans 7"
IOA calculate
IOA SOURCE "Test 0"
IOA @BEGIN
IOA CALCULATE "GenCol 64" @EXPRESSION column\\GenCol 65
IOA CALCULATE "New 1" @EXPRESSION @call function\\number\abs(column\\GenCol 64)
IOA @END
IOA DISPLAY @BEGIN
IOA POSITION 1 1
IOA SHOWCOLUMNS ALL
IOA @END DISPLAY
@END IOA TRANSFORMATION

TRANSFORMATION @BEGIN YWQ
YWQ "Trans 4"
YWQ join
YWQ SOURCE "Test 0" "Test 0"
YWQ @BEGIN
YWQ INNERJOIN
YWQ "GenCol 62" EQUALS "GenCol 62"
YWQ "GenCol 64" EQUALS "GenCol 64"
YWQ @END
YWQ DISPLAY @BEGIN
YWQ POSITION 1 1
YWQ SHOWCOLUMNS ALL
YWQ @END DISPLAY
@END YWQ TRANSFORMATION

TRANSFORMATION @BEGIN PUW
PUW "Trans 2"
PUW filter
PUW SOURCE "Test 0"
PUW @BEGIN
PUW KEEPIF column\\GenCol 62 > @call function\\list\element(table\\Test 0#GenCol 62, 2)
PUW @END
PUW DISPLAY @BEGIN
PUW POSITION 1 1
PUW SHOWCOLUMNS ALL
PUW @END DISPLAY
@END PUW TRANSFORMATION

TRANSFORMATION @BEGIN PFD
PFD "Trans 1"
PFD filter
PFD SOURCE "Test 0"
PFD @BEGIN
PFD KEEPIF column\\GenCol 64 <= @call function\\list\element(table\\Test 0#GenCol 64, 4)
PFD @END
PFD DISPLAY @BEGIN
PFD POSITION 1 1
PFD SHOWCOLUMNS ALL
PFD @END DISPLAY
@END PFD TRANSFORMATION

TRANSFORMATION @BEGIN FWF
FWF "Trans 3"
FWF concatenate
FWF SOURCE "Trans 1"
FWF @BEGIN
FWF @INCOMPLETE WRAPMAYBE SOURCE 
FWF @END
FWF DISPLAY @BEGIN
FWF POSITION 1 1
FWF SHOWCOLUMNS ALL
FWF @END DISPLAY
@END FWF TRANSFORMATION

